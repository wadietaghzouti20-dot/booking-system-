/** Clinic Booking System 1 backend. Set SPREADSHEET_ID, ADMIN_EMAIL and CLINIC_NAME in Script Properties. */
const HEADERS={Appointments:["Booking ID","Created At","Updated At","Patient Name","Phone","Email","Appointment Type","Requested Date","Requested Time","Appointment Duration","Optional Note","Status","Confirmation Token Hash","Cancellation Token Hash","Last Notification Status","Admin Notes","Client Request ID"],Settings:["Key","Value"],AuditLog:["Timestamp","Booking ID","Action","Details"]};
const DEFAULTS={CLINIC_NAME:"Clinic Booking System 1",CLINIC_TIMEZONE:"Africa/Algiers",ADMIN_EMAIL:"",OPEN_DAYS:"Monday,Tuesday,Wednesday,Thursday,Friday,Saturday",OPEN_TIME:"09:00",CLOSE_TIME:"18:00",APPOINTMENT_DURATION_MINUTES:"30",BUFFER_MINUTES:"0",BOOKING_POLICY:"PENDING",RESCHEDULING_CUTOFF_HOURS:"24"};
function setup(){const p=PropertiesService.getScriptProperties(),id=p.getProperty("SPREADSHEET_ID");if(!id)throw Error("Set SPREADSHEET_ID in Script Properties first.");const ss=SpreadsheetApp.openById(id);Object.keys(HEADERS).forEach(n=>{let s=ss.getSheetByName(n)||ss.insertSheet(n),h=HEADERS[n];h.forEach((v,i)=>{if(s.getRange(1,i+1).getValue()!==v)s.getRange(1,i+1).setValue(v)});s.setFrozenRows(1)});const sh=ss.getSheetByName("Settings"),rows=sh.getLastRow()>1?sh.getRange(2,1,sh.getLastRow()-1,2).getValues():[],seen=new Set(rows.map(r=>String(r[0])));Object.keys(DEFAULTS).forEach(k=>{if(!seen.has(k))sh.appendRow([k,DEFAULTS[k]])});return {ok:true,message:"Setup complete"}}
function doGet(){return out_({ok:true,service:"Clinic Booking System 1"})}
function doPost(e){try{const raw=e&&e.postData&&e.postData.contents;if(!raw||raw.length>12000)return out_({ok:false,message:"Invalid request."});const d=JSON.parse(raw);if(d.action!=="submitBooking")return out_({ok:false,message:"Unsupported request."});return out_(submit_(d))}catch(err){console.error("Booking submission failed: "+String(err.message||err).slice(0,120));return out_({ok:false,message:String(err.message||"Request could not be saved.").slice(0,180)})}}
function submit_(d){const x=validate_(d),lock=LockService.getScriptLock();lock.waitLock(10000);let id,status="PENDING";try{const sh=ss_().getSheetByName("Appointments"),last=sh.getLastRow();if(last>1&&x.requestId){const ids=sh.getRange(2,17,last-1,1).getDisplayValues().flat(),i=ids.indexOf(x.requestId);if(i>=0){const r=sh.getRange(i+2,1,1,17).getDisplayValues()[0];return {ok:true,bookingId:r[0],status:r[11],duplicate:true}}}id="CBS1-"+Utilities.getUuid().replace(/-/g,"").slice(0,12).toUpperCase();const now=new Date();sh.appendRow([id,now,now,x.name,x.phone,x.email,x.type,x.date,x.time,setting_("APPOINTMENT_DURATION_MINUTES","30"),x.note,status,"","","PENDING_EMAIL_NOT_ATTEMPTED","",x.requestId]);sh.getRange(sh.getLastRow(),2,1,2).setNumberFormat("yyyy-mm-dd hh:mm:ss");audit_(id,"REQUEST_CREATED","Status=PENDING")}finally{lock.releaseLock()}const ns=notify_(id,x);try{const sh=ss_().getSheetByName("Appointments"),r=sh.getLastRow();sh.getRange(r,15).setValue(ns)}catch(e){}return {ok:true,bookingId:id,status:status,notificationStatus:ns}}
function validate_(d){const t=v=>String(v==null?"":v).replace(/[\u0000-\u001f\u007f]/g," ").trim();const name=t(d.patientName).slice(0,100),phone=t(d.phone).slice(0,25),email=t(d.email).slice(0,254),type=t(d.appointmentType),date=t(d.requestedDate),time=t(d.requestedTime),note=t(d.note).slice(0,300),requestId=t(d.clientRequestId).slice(0,80);if(!d.consent)throw Error("Consent is required.");if(name.length<2)throw Error("Enter your full name.");if(phone.replace(/[^0-9+]/g,"").length<7)throw Error("Enter a valid phone number.");if(email&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email))throw Error("Enter a valid email address.");if(!["Consultation","Follow-up appointment","Other"].includes(type))throw Error("Choose an appointment type.");if(!/^\d{4}-\d{2}-\d{2}$/.test(date))throw Error("Choose a valid date.");const a=date.split("-").map(Number),dt=new Date(Date.UTC(a[0],a[1]-1,a[2]));if(dt.getUTCFullYear()!==a[0]||dt.getUTCMonth()!==a[1]-1||dt.getUTCDate()!==a[2])throw Error("Choose a valid date.");if(date<Utilities.formatDate(new Date(),setting_("CLINIC_TIMEZONE","Africa/Algiers"),"yyyy-MM-dd"))throw Error("The requested date cannot be in the past.");if(!["ANY","MORNING","AFTERNOON"].includes(time))throw Error("Choose a preferred time.");return {name:cell_(name),phone:cell_(phone),email:cell_(email),type:type,date:date,time:time,note:cell_(note),requestId:requestId}}
function cell_(s){return /^[=+@\-]/.test(s)?"'"+s:s}
function notify_(id,x){const p=PropertiesService.getScriptProperties(),admin=p.getProperty("ADMIN_EMAIL")||setting_("ADMIN_EMAIL",""),clinic=p.getProperty("CLINIC_NAME")||setting_("CLINIC_NAME","Clinic Booking System 1");if(!admin||!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(admin))return "SKIPPED_ADMIN_EMAIL_NOT_CONFIGURED";try{MailApp.sendEmail({to:admin,subject:"New appointment request — "+id,body:"A request is pending review, not confirmed.\nReference: "+id+"\nName: "+x.name+"\nPhone: "+x.phone+"\nEmail: "+(x.email||"Not provided")+"\nType: "+x.type+"\nPreferred date: "+x.date+"\nPreferred time: "+x.time+"\nNote: "+(x.note||"None")})}catch(e){return "ADMIN_EMAIL_FAILED"}if(x.email){try{MailApp.sendEmail({to:x.email,subject:"Request received — "+clinic,body:"Hello "+x.name+",\n\nThe clinic received your appointment request. It is pending review and is NOT confirmed.\nReference: "+id+"\nPreferred date: "+x.date+"\nPreferred time: "+x.time+"\nThe clinic will contact you after reviewing it."})}catch(e){return "ADMIN_SENT_PATIENT_EMAIL_FAILED"}}return "SENT"}
function ss_(){const id=PropertiesService.getScriptProperties().getProperty("SPREADSHEET_ID");if(!id)throw Error("Backend is not configured.");return SpreadsheetApp.openById(id)}
function setting_(k,f){const p=PropertiesService.getScriptProperties().getProperty(k);if(p!==null)return p;try{const s=ss_().getSheetByName("Settings");if(s&&s.getLastRow()>1){const r=s.getRange(2,1,s.getLastRow()-1,2).getValues();for(let i=0;i<r.length;i++)if(String(r[i][0])===k)return String(r[i][1])}}catch(e){}return f}
function audit_(id,action,details){try{ss_().getSheetByName("AuditLog").appendRow([new Date(),id,action,String(details||"").slice(0,200)])}catch(e){console.error("Audit log write failed")}}
function out_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}
